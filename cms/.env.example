# ===========================================================================
# CMS de Diabolical: variables de entorno.
# En producción van en Dokploy (nunca en el repositorio). En desarrollo no hace
# falta ninguna: por defecto usa PGlite en cms/api/.datos.
# ===========================================================================

NODE_ENV=production
CMS_PUERTO=3100

# Origen público del sitio: se compara con la cabecera Origin (CSRF).
CMS_ORIGEN=https://diabolicalservices.tech

# Conexión de trabajo, con el rol cms_app (sujeto a Row Level Security).
CMS_BASE_DATOS=postgres://cms_app:CAMBIAR@cms-db:5432/cms
# Conexión del dueño del esquema, solo para migrar al arrancar.
CMS_BASE_DATOS_MIGRAR=postgres://cms_dueno:CAMBIAR@cms-db:5432/cms

# Detrás de Traefik la IP real llega en X-Forwarded-For.
CMS_CONFIAR_PROXY=1
# Intentos de inicio de sesión por IP cada 15 minutos.
CMS_LIMITE_ACCESO=10

# Correo saliente (avisos de inicio de sesión): el Postfix de BillionMail.
SMTP_HOST=
SMTP_PUERTO=587
SMTP_SEGURO=0
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE="Panel Diabolical <panel@diabolicalservices.tech>"
