# Copia este archivo a .env y rellena los valores. .env NO se sube al repositorio.

# --- Servidor ---------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Dominio público. Se usa en canonical, Open Graph, sitemap y JSON-LD.
SITE_URL=https://diabolicalservices.tech

# Directorio persistente para settings.json. Por defecto es ./data dentro del
# repositorio, que sirve en local. En Docker descomenta esta línea para que
# apunte al volumen montado; sin volumen, lo que guardes en /admin se pierde en
# cada despliegue.
# DATA_DIR=/app/data

# --- Panel /admin -----------------------------------------------------------
# Si falta cualquiera de las tres, el panel queda deshabilitado (fail-closed).
ADMIN_USERNAME=admin

# Hash bcrypt de la contraseña. Genéralo con:  npm run hash-password
ADMIN_PASSWORD_HASH=

# Secreto para firmar la cookie de sesión. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Horas de validez de la sesión del panel.
SESSION_TTL_HOURS=8

# --- Seguridad --------------------------------------------------------------
# Orígenes extra autorizados a llamar la API, separados por coma.
# Vacío = solo mismo origen (recomendado).
CORS_ORIGINS=

# true = la CSP solo reporta violaciones sin bloquear. Útil para validar un
# despliegue antes de forzarla.
CSP_REPORT_ONLY=false

# --- Integraciones ----------------------------------------------------------
# Origen del webhook de n8n. Debe coincidir con VITE_N8N_WEBHOOK_URL para que
# la CSP permita la petición desde el navegador.
N8N_ORIGIN=https://n8n.diabolicalservices.tech

# --- Cliente (compiladas en el bundle por Vite: NO pongas secretos aquí) -----
VITE_SITE_URL=https://diabolicalservices.tech
VITE_WHATSAPP_PHONE=524495136907
VITE_N8N_WEBHOOK_URL=https://n8n.diabolicalservices.tech/webhook/9b0c65c5-32f4-4f80-aa01-0730f9812e88
VITE_CONTACT_EMAIL=contacto@diabolicalservices.tech
