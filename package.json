{
  "name": "landing-d",
  "version": "1.0.0",
  "description": "Diabolical Services Landing Page",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.config.ssr.js && node scripts/prerender.mjs",
